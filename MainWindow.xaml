<Window
    x:Class="WinUIXamlDesigner.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinUI XAML Designer">

    <Grid x:Name="RootLayout" RowDefinitions="Auto,*,Auto" Background="{ThemeResource DesignerPageBackgroundBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="打开文件" Click="OpenXaml_Click"/>
            <AppBarButton Icon="Folder" Label="打开项目" Click="OpenProject_Click"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="撤销" Click="Undo_Click"/>
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="重做" Click="Redo_Click"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Save" Label="保存" Click="Save_Click"/>
            <AppBarButton Icon="Refresh" Label="重载" Click="Reload_Click"/>
            <AppBarSeparator/>
            <AppBarToggleButton x:Name="AutoWriteToggle" Icon="Accept" Label="自动保存" IsChecked="False"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Help" Label="关于我们" Click="About_Click"/>
        </CommandBar>

        <Grid Grid.Row="1" ColumnDefinitions="235,*,390">
            <Border Grid.Column="0" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto,Auto">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="12" Spacing="8">
                            <Border Background="{ThemeResource DesignerTitleBarBrush}" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="TipText" Text="Tip: 正在准备提示…" TextWrapping="Wrap" Opacity="0.82"/>
                            </Border>
                            <TextBlock Text="控件列表" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="按住控件直接拖到画布中。单击画布控件可选中，单击空白区域可选中窗口。" Opacity="0.68" TextWrapping="Wrap"/>
                            <ListView x:Name="ToolboxList"
                                      SelectionMode="None"
                                      CanDragItems="True"
                                      CanReorderItems="False"
                                      DragItemsStarting="Toolbox_DragItemsStarting"
                                      DragItemsCompleted="Toolbox_DragItemsCompleted">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="8,7">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14"/>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="网格（Grid）" FontSize="16" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="AddRowButton" Content="＋ 行" Click="AddRow_Click"/>
                                <Button x:Name="RemoveRowButton" Grid.Column="1" Content="－ 行" Click="RemoveRow_Click"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="AddColumnButton" Content="＋ 列" Click="AddColumn_Click"/>
                                <Button x:Name="RemoveColumnButton" Grid.Column="1" Content="－ 列" Click="RemoveColumn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="设计视图" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="自绘预览不运行真实控件模板，只表示布局、控件类型和核心属性。" Opacity="0.65" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="16" CornerRadius="8"
                    BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1"
                    Background="{ThemeResource DesignerCardBackgroundBrush}">
                <ScrollViewer x:Name="DesignPreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PointerWheelChanged="DesignCanvas_PointerWheelChanged">
                    <Viewbox x:Name="DesignPreviewViewbox"
                             Width="900" Height="662"
                             Stretch="Fill"
                             StretchDirection="Both">
                        <Border x:Name="DesignPreviewWindow"
                                Width="900" Height="662"
                                Background="{ThemeResource DesignerCardBackgroundBrush}"
                                BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1">
                            <Grid RowDefinitions="42,*">
                                <Border x:Name="WindowTitleBar" Grid.Row="0" Height="42"
                                        Background="{ThemeResource DesignerTitleBarBrush}"
                                        BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,0,0,1"
                                        IsHitTestVisible="False">
                                    <Grid Padding="12,0">
                                        <TextBlock x:Name="PreviewWindowTitleText"
                                                   Text="Window"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                                <Canvas x:Name="DesignCanvas" Grid.Row="1" Width="900" Height="620"
                                        Background="{ThemeResource DesignerCanvasBackgroundBrush}"
                                        PointerPressed="DesignCanvas_PointerPressed"
                                        PointerMoved="DesignCanvas_PointerMoved"
                                        PointerReleased="DesignCanvas_PointerReleased"
                                        PointerCanceled="DesignCanvas_PointerCanceled"
                                        PointerExited="DesignCanvas_PointerExited"
                                        AllowDrop="True"
                                        DragOver="DesignCanvas_DragOver"
                                        DragLeave="DesignCanvas_DragLeave"
                                        Drop="DesignCanvas_Drop"
                                        DoubleTapped="DesignCanvas_DoubleTapped"
                                        RightTapped="DesignCanvas_RightTapped"
                                        KeyDown="DesignCanvas_KeyDown"/>
                            </Grid>
                        </Border>
                    </Viewbox>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16" Spacing="9">
                        <TextBlock Text="属性" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedTypeText" Text="窗口（Window）" Opacity="0.7"/>

                        <TextBlock Text="窗口（Window）" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock Text="Title（标题）"/>
                        <TextBox x:Name="WindowTitleBox" Tag="Title" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Width（宽度）"/>
                                <TextBox x:Name="WindowWidthBox" Tag="Width" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Height（高度）"/>
                                <TextBox x:Name="WindowHeightBox" Tag="Height" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="MinWidth（最小宽度）"/>
                                <TextBox x:Name="WindowMinWidthBox" Tag="MinWidth" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MinHeight（最小高度）"/>
                                <TextBox x:Name="WindowMinHeightBox" Tag="MinHeight" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="MaxWidth（最大宽度）"/>
                                <TextBox x:Name="WindowMaxWidthBox" Tag="MaxWidth" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MaxHeight（最大高度）"/>
                                <TextBox x:Name="WindowMaxHeightBox" Tag="MaxHeight" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="RequestedTheme（请求主题）"/>
                        <ComboBox x:Name="WindowThemeBox" Tag="RequestedTheme" SelectionChanged="PropertyCombo_Changed">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="Default"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                        </ComboBox>
                        <TextBlock Text="ExtendsContentIntoTitleBar（内容延伸至标题栏）"/>
                        <ComboBox x:Name="WindowExtendTitleBarBox" Tag="ExtendsContentIntoTitleBar" SelectionChanged="PropertyCombo_Changed">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="True"/>
                            <ComboBoxItem Content="False"/>
                        </ComboBox>

                        <TextBlock Text="控件（Control）" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"/>
                        <TextBlock Text="x:Name（控件名称）"/>
                        <TextBox x:Name="NameBox" Tag="__Name" PlaceholderText="例如 Button1" LostFocus="NameBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <TextBlock Text="Content / Text（内容 / 文本）"/>
                        <TextBox x:Name="ContentBox" Tag="ContentOrText" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <TextBlock Text="ToolTip（提示）"/>
                        <TextBox x:Name="ToolTipBox" Tag="ToolTip" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Grid.Row（所在行）"/>
                                <NumberBox x:Name="RowBox" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="GridValueChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Grid.Column（所在列）"/>
                                <NumberBox x:Name="ColumnBox" Minimum="0" SpinButtonPlacementMode="Compact" ValueChanged="GridValueChanged"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="RowSpan（跨行数）"/>
                                <NumberBox x:Name="RowSpanBox" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="GridValueChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ColumnSpan（跨列数）"/>
                                <NumberBox x:Name="ColumnSpanBox" Minimum="1" SpinButtonPlacementMode="Compact" ValueChanged="GridValueChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Width（宽度）"/>
                                <TextBox x:Name="WidthBox" Tag="Width" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Height（高度）"/>
                                <TextBox x:Name="HeightBox" Tag="Height" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="MinWidth（最小宽度）"/>
                                <TextBox x:Name="MinWidthBox" Tag="MinWidth" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MaxWidth（最大宽度）"/>
                                <TextBox x:Name="MaxWidthBox" Tag="MaxWidth" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="MinHeight（最小高度）"/>
                                <TextBox x:Name="MinHeightBox" Tag="MinHeight" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="MaxHeight（最大高度）"/>
                                <TextBox x:Name="MaxHeightBox" Tag="MaxHeight" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Margin（外边距）"/>
                        <TextBox x:Name="MarginBox" Tag="Margin" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <TextBlock Text="Padding（内边距）"/>
                        <TextBox x:Name="PaddingBox" Tag="Padding" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="HorizontalAlignment（水平对齐）"/>
                                <ComboBox x:Name="HorizontalAlignmentBox" Tag="HorizontalAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                    <ComboBoxItem Content="Stretch"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VerticalAlignment（垂直对齐）"/>
                                <ComboBox x:Name="VerticalAlignmentBox" Tag="VerticalAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Top"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Bottom"/>
                                    <ComboBoxItem Content="Stretch"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="HorizontalContentAlignment（水平内容对齐）"/>
                                <ComboBox x:Name="HorizontalContentAlignmentBox" Tag="HorizontalContentAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                    <ComboBoxItem Content="Stretch"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VerticalContentAlignment（垂直内容对齐）"/>
                                <ComboBox x:Name="VerticalContentAlignmentBox" Tag="VerticalContentAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Top"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Bottom"/>
                                    <ComboBoxItem Content="Stretch"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="FontSize（字体大小）"/>
                                <TextBox x:Name="FontSizeBox" Tag="FontSize" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FontWeight（字体粗细）"/>
                                <ComboBox x:Name="FontWeightBox" Tag="FontWeight" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="SemiBold"/>
                                    <ComboBoxItem Content="Bold"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="CharacterSpacing（字符间距）"/>
                        <TextBox x:Name="CharacterSpacingBox" Tag="CharacterSpacing" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Foreground（前景色）"/>
                                <TextBox x:Name="ForegroundBox" Tag="Foreground" PlaceholderText="#RRGGBB 或资源键" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Background（背景色）"/>
                                <TextBox x:Name="BackgroundBox" Tag="Background" PlaceholderText="#RRGGBB 或资源键" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="BorderBrush（边框画刷）"/>
                                <TextBox x:Name="BorderBrushBox" Tag="BorderBrush" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BorderThickness（边框粗细）"/>
                                <TextBox x:Name="BorderThicknessBox" Tag="BorderThickness" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="CornerRadius（圆角）"/>
                                <TextBox x:Name="CornerRadiusBox" Tag="CornerRadius" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Opacity（不透明度）"/>
                                <TextBox x:Name="OpacityBox" Tag="Opacity" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Visibility（可见性）"/>
                                <ComboBox x:Name="VisibilityBox" Tag="Visibility" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Visible"/>
                                    <ComboBoxItem Content="Collapsed"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsEnabled（是否启用）"/>
                                <ComboBox x:Name="IsEnabledBox" Tag="IsEnabled" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="IsTabStop（是否可 Tab 聚焦）"/>
                                <ComboBox x:Name="IsTabStopBox" Tag="IsTabStop" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsHitTestVisible（是否接收命中）"/>
                                <ComboBox x:Name="IsHitTestVisibleBox" Tag="IsHitTestVisible" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="控件专属属性" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock Text="Source（资源路径）"/>
                        <TextBox x:Name="SourceBox" Tag="Source" PlaceholderText="例如 Assets/logo.png" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                        <TextBlock Text="Stretch（拉伸方式）"/>
                        <ComboBox x:Name="StretchBox" Tag="Stretch" SelectionChanged="PropertyCombo_Changed">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Fill"/>
                            <ComboBoxItem Content="Uniform"/>
                            <ComboBoxItem Content="UniformToFill"/>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="PlaceholderText（占位文本）"/>
                                <TextBox x:Name="PlaceholderTextBox" Tag="PlaceholderText" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Header（标题内容）"/>
                                <TextBox x:Name="HeaderBox" Tag="Header" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="TextWrapping（文本换行）"/>
                        <ComboBox x:Name="TextWrappingBox" Tag="TextWrapping" SelectionChanged="PropertyCombo_Changed">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="NoWrap"/>
                            <ComboBoxItem Content="Wrap"/>
                            <ComboBoxItem Content="WrapWholeWords"/>
                        </ComboBox>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="MaxLength（最大长度）"/>
                                <TextBox x:Name="MaxLengthBox" Tag="MaxLength" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SelectedIndex（选中索引）"/>
                                <TextBox x:Name="SelectedIndexBox" Tag="SelectedIndex" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Minimum（最小值）"/>
                                <TextBox x:Name="MinimumBox" Tag="Minimum" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Maximum（最大值）"/>
                                <TextBox x:Name="MaximumBox" Tag="Maximum" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Value（当前值）"/>
                                <TextBox x:Name="ValueBox" Tag="Value" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Orientation（方向）"/>
                                <ComboBox x:Name="OrientationBox" Tag="Orientation" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Horizontal"/>
                                    <ComboBoxItem Content="Vertical"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="IsChecked（是否选中）"/>
                                <ComboBox x:Name="IsCheckedBox" Tag="IsChecked" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsOn（是否开启）"/>
                                <ComboBox x:Name="IsOnBox" Tag="IsOn" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="OnContent（开启内容）"/>
                                <TextBox x:Name="OnContentBox" Tag="OnContent" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OffContent（关闭内容）"/>
                                <TextBox x:Name="OffContentBox" Tag="OffContent" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="GroupName（单选分组）"/>
                                <TextBox x:Name="GroupNameBox" Tag="GroupName" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsEditable（是否可编辑）"/>
                                <ComboBox x:Name="IsEditableBox" Tag="IsEditable" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="AcceptsReturn（接受回车换行）"/>
                                <ComboBox x:Name="AcceptsReturnBox" Tag="AcceptsReturn" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsReadOnly（只读）"/>
                                <ComboBox x:Name="IsReadOnlyBox" Tag="IsReadOnly" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="更多属性" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="FontFamily（字体）"/>
                                <TextBox x:Name="FontFamilyBox" Tag="FontFamily" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FontStyle（字体样式）"/>
                                <ComboBox x:Name="FontStyleBox" Tag="FontStyle" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Normal"/>
                                    <ComboBoxItem Content="Italic"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="TextAlignment（文本对齐）"/>
                                <ComboBox x:Name="TextAlignmentBox" Tag="TextAlignment" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Left"/>
                                    <ComboBoxItem Content="Center"/>
                                    <ComboBoxItem Content="Right"/>
                                    <ComboBoxItem Content="Justify"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FlowDirection（文本流向）"/>
                                <ComboBox x:Name="FlowDirectionBox" Tag="FlowDirection" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="LeftToRight"/>
                                    <ComboBoxItem Content="RightToLeft"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="TabIndex（Tab 顺序）"/>
                                <TextBox x:Name="TabIndexBox" Tag="TabIndex" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="UseSystemFocusVisuals（系统焦点视觉）"/>
                                <ComboBox x:Name="UseSystemFocusVisualsBox" Tag="UseSystemFocusVisuals" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Command（命令）"/>
                                <TextBox x:Name="CommandBox" Tag="Command" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CommandParameter（命令参数）"/>
                                <TextBox x:Name="CommandParameterBox" Tag="CommandParameter" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="IsDefault（默认按钮）"/>
                                <ComboBox x:Name="IsDefaultBox" Tag="IsDefault" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsCancel（取消按钮）"/>
                                <ComboBox x:Name="IsCancelBox" Tag="IsCancel" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="ClickMode（点击模式）"/>
                                <ComboBox x:Name="ClickModeBox" Tag="ClickMode" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="Release"/>
                                    <ComboBoxItem Content="Press"/>
                                    <ComboBoxItem Content="Hover"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IsIndeterminate（不确定进度）"/>
                                <ComboBox x:Name="IsIndeterminateBox" Tag="IsIndeterminate" SelectionChanged="PropertyCombo_Changed">
                                    <ComboBoxItem Content=""/>
                                    <ComboBoxItem Content="True"/>
                                    <ComboBoxItem Content="False"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="DateFormat（日期格式）"/>
                                <TextBox x:Name="DateFormatBox" Tag="DateFormat" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NumberFormat（数字格式）"/>
                                <TextBox x:Name="NumberFormatBox" Tag="NumberFormat" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Language（语言）"/>
                                <TextBox x:Name="LanguageBox" Tag="Language" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tag（自定义标签）"/>
                                <TextBox x:Name="TagBox" Tag="Tag" LostFocus="PropertyBox_LostFocus" KeyDown="Editor_KeyDown"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="事件（Event - 事件处理）" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="EventText" Text="—" TextWrapping="Wrap"/>
                        <Button x:Name="DeleteButton" Content="删除控件" Click="DeleteSelected_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{ThemeResource DesignerCardStrokeBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                <TextBlock x:Name="StatusText" Text="未打开文件"/>
                <TextBlock Grid.Column="1" x:Name="GridStatusText" Text="Grid 1 × 1" Margin="20,0"/>
                <TextBlock Grid.Column="2" x:Name="HintText" Text="WinUI XAML Designer by MsintX" Opacity="0.65"/>
            </Grid>
        </Border>
    </Grid>
</Window>
